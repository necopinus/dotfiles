#!/usr/bin/env bash
#
# dotfiles pre-commit hook
#
# Runs linters/formatters on staged files. Excludes the
# bundles/opencode/modules/simple-english submodule (third-party).
#
# Requires: alejandra, statix, deadnix, shellcheck, shfmt, yamllint,
# betterleaks. All are added to home.packages in modules/git/default.nix.
#
# Set DOTFILES_PRE_COMMIT_SKIP_MISSING=1 to warn-and-continue when a tool
# is unavailable (useful on minimal systems); the default is to fail.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- helpers --------------------------------------------------------------

log() { printf '\033[1;34m[pre-commit]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[pre-commit][warn]\033[0m %s\n' "$*" >&2; }
fail() {
  printf '\033[1;31m[pre-commit][fail]\033[0m %s\n' "$*" >&2
  exit 1
}

require_tool() {
  local tool="$1"
  if ! command -v "$tool" >/dev/null 2>&1; then
    if [[ "${DOTFILES_PRE_COMMIT_SKIP_MISSING:-0}" == "1" ]]; then
      warn "$tool not found in PATH; skipping $2 checks"
      return 1
    fi
    fail "$tool not found in PATH; install it or set DOTFILES_PRE_COMMIT_SKIP_MISSING=1"
  fi
  return 0
}

# --- collect staged files -------------------------------------------------

mapfile -t STAGED < <(
  git diff --cached --name-only --diff-filter=ACMR
)

if [[ ${#STAGED[@]} -eq 0 ]]; then
  log "no staged files; nothing to check"
  exit 0
fi

# --- filter to file types and exclude submodule + ignored -----------------

EXCLUDE_RE='^bundles/opencode/modules/simple-english/'

NIX_FILES=()
SH_FILES=()
YAML_FILES=()
ALL_FILES=()

for f in "${STAGED[@]}"; do
  [[ -e "$REPO_ROOT/$f" ]] || continue
  [[ "$f" =~ $EXCLUDE_RE ]] && continue
  ALL_FILES+=("$f")
  case "$f" in
  *.nix) NIX_FILES+=("$f") ;;
  *.sh | *.bash) SH_FILES+=("$f") ;;
  *.yaml | *.yml) YAML_FILES+=("$f") ;;
  esac
done

if [[ ${#ALL_FILES[@]} -eq 0 ]]; then
  log "all staged files excluded (submodule or filtered); nothing to check"
  exit 0
fi

# --- Nix ------------------------------------------------------------------

if [[ ${#NIX_FILES[@]} -gt 0 ]] && require_tool alejandra nix; then
  log "alejandra: ${#NIX_FILES[@]} file(s)"
  alejandra --check "${NIX_FILES[@]}"
fi

if [[ ${#NIX_FILES[@]} -gt 0 ]] && require_tool statix nix; then
    log "statix: ${#NIX_FILES[@]} file(s) staged; running repo-wide check"
    # statix only loads statix.toml when given a directory target. Run
    # `statix check .` from the repo root so the config is honored (it
    # disables the `repeated_keys` lint which fires on idiomatic
    # home-manager patterns). Per-file invocation would also work, but
    # would skip the config and thus false-positive on every commit.
    (cd "$REPO_ROOT" && statix check .)
fi

if [[ ${#NIX_FILES[@]} -gt 0 ]] && require_tool deadnix nix; then
  log "deadnix: ${#NIX_FILES[@]} file(s)"
  deadnix "${NIX_FILES[@]}"
fi

# --- Shell ----------------------------------------------------------------

if [[ ${#SH_FILES[@]} -gt 0 ]] && require_tool shellcheck shell; then
  log "shellcheck: ${#SH_FILES[@]} file(s)"
  shellcheck "${SH_FILES[@]}"
fi

if [[ ${#SH_FILES[@]} -gt 0 ]] && require_tool shfmt shell; then
  log "shfmt: ${#SH_FILES[@]} file(s)"
  # -i 2: enforce 2 space indents
  # -d: diff only (don't modify the file).
  shfmt -i 2 -d "${SH_FILES[@]}"
fi

# --- YAML -----------------------------------------------------------------

if [[ ${#YAML_FILES[@]} -gt 0 ]] && require_tool yamllint yaml; then
  log "yamllint: ${#YAML_FILES[@]} file(s)"
  yamllint -d "{extends: default, rules: {line-length: {max: 120}}}" "${YAML_FILES[@]}"
fi

# --- Secret scan (always run) ---------------------------------------------

if [[ ${#ALL_FILES[@]} -gt 0 ]] && require_tool betterleaks secrets; then
  log "betterleaks: scanning ${#ALL_FILES[@]} file(s)"
  betterleaks protect --staged --no-banner "${ALL_FILES[@]}"
fi

log "all checks passed"
