#!/usr/bin/env bash
#
# dotfiles pre-commit hook
#
# Runs linters/formatters on staged files.
#
# Requires: alejandra, statix, deadnix, shellcheck, shfmt, yamllint,
# betterleaks. All are added to home.packages in modules/git/default.nix.
#
# Set DOTFILES_PRE_COMMIT_SKIP_MISSING=1 to warn-and-continue when a tool
# is unavailable (useful on minimal systems); the default is to fail.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- helpers --------------------------------------------------------------

log() { printf '\033[1;34m[pre-commit]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[pre-commit][warn]\033[0m %s\n' "$*" >&2; }
fail() {
  printf '\033[1;31m[pre-commit][fail]\033[0m %s\n' "$1" >&2
  exit 1
}

require_tool() {
  local tool="$1"
  if ! command -v "$tool" >/dev/null 2>&1; then
    if [[ "${DOTFILES_PRE_COMMIT_SKIP_MISSING:-0}" == "1" ]]; then
      warn "$tool not found in PATH; skipping $2 checks"
      return 1
    fi
    fail "$tool not found in PATH; install it or set DOTFILES_PRE_COMMIT_SKIP_MISSING=1"
  fi
  return 0
}

# --- collect staged files -------------------------------------------------

STAGED=()
while IFS= read -r -d '' file; do
  STAGED+=("$file")
done < <(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -z)

if [[ ${#STAGED[@]} -eq 0 ]]; then
  log "no staged files; nothing to check"
  exit 0
fi

# --- filter to file types --------------------------------------------------

NIX_FILES=()
SH_FILES=()
YAML_FILES=()
MD_FILES=()
ALL_FILES=()

for file in "${STAGED[@]}"; do
  [[ -e "$REPO_ROOT/$file" ]] || continue
  ALL_FILES+=("$file")
  case "$file" in
  *.nix) NIX_FILES+=("$file") ;;
  *.sh | *.bash) SH_FILES+=("$file") ;;
  *.yaml | *.yml) YAML_FILES+=("$file") ;;
  *.md | *.markdown) MD_FILES+=("$file") ;;
  esac
done

if [[ ${#ALL_FILES[@]} -eq 0 ]]; then
  log "all staged files filtered out; nothing to check"
  exit 0
fi

# --- Nix ------------------------------------------------------------------

if [[ ${#NIX_FILES[@]} -gt 0 ]] && require_tool alejandra nix; then
  log "alejandra: ${#NIX_FILES[@]} file(s)"
  alejandra --check "${NIX_FILES[@]}"
fi

if [[ ${#NIX_FILES[@]} -gt 0 ]] && require_tool statix nix; then
  log "statix: checking a temporary copy of the staged tree"
  STAGE_DIR="$(mktemp -d)"
  trap 'if [[ -n "${STAGE_DIR:-}" ]]; then rm -rf "$STAGE_DIR"; fi' EXIT
  (cd "$REPO_ROOT" && git checkout-index --all --prefix="$STAGE_DIR/")
  (cd "$STAGE_DIR" && statix check .)
fi

if [[ ${#NIX_FILES[@]} -gt 0 ]] && require_tool deadnix nix; then
  log "deadnix: ${#NIX_FILES[@]} file(s)"
  deadnix --fail "${NIX_FILES[@]}"
fi

# --- Shell ----------------------------------------------------------------

if [[ ${#SH_FILES[@]} -gt 0 ]] && require_tool shellcheck shell; then
  log "shellcheck: ${#SH_FILES[@]} file(s)"
  shellcheck "${SH_FILES[@]}"
fi

if [[ ${#SH_FILES[@]} -gt 0 ]] && require_tool shfmt shell; then
  log "shfmt: ${#SH_FILES[@]} file(s)"
  # -i 2: enforce 2 space indents
  # -w: format the files in place.
  shfmt -i 2 -w "${SH_FILES[@]}"
  # Restage the formatted files so the commit includes the changes.
  git add -- "${SH_FILES[@]}"
fi

# --- YAML -----------------------------------------------------------------

if [[ ${#YAML_FILES[@]} -gt 0 ]] && require_tool yamllint yaml; then
  log "yamllint: ${#YAML_FILES[@]} file(s)"
  yamllint -d "{extends: default, rules: {line-length: {max: 120}}}" "${YAML_FILES[@]}"
fi

# --- Markdown -------------------------------------------------------------

if [[ ${#MD_FILES[@]} -gt 0 ]] && require_tool markdownlint-cli2 markdown; then
  log "markdownlint-cli2: ${#MD_FILES[@]} file(s)"
  markdownlint-cli2 "${MD_FILES[@]}"
fi

# --- Secret scan (always run) ---------------------------------------------

if [[ ${#ALL_FILES[@]} -gt 0 ]] && require_tool betterleaks secrets; then
  log "betterleaks: scanning staged content"
  betterleaks protect --staged --no-banner
fi

log "all checks passed"
