# Top-level defaults apply to all files unless overridden below.
# Per-language overrides reflect each language's dominant convention in
# this repo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Nix is formatted by alejandra (2-space indent).
[*.nix]
indent_style = space
indent_size = 2

# Python is formatted by ruff format (4-space indent).
[*.py]
indent_style = space
indent_size = 4

# Shell scripts are formatted by shfmt -i 2 (see .githooks/pre-commit).
# shfmt keeps the mandatory tab indentation of <<-EOF heredoc bodies and
# closing delimiters even when indenting with spaces, so 2-space is safe.
[*.sh]
indent_style = space
indent_size = 2

# YAML in this repo is 2-space (matches alejandra's default style for
# most data structures; yamllint's default indentation rule agrees).
[*.{yaml,yml}]
indent_style = space
indent_size = 2

# Markdown: per the user's preference, tabs are common in vault content
# (code blocks, line continuations). Don't try to enforce one style.
[*.md]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = false

# Makefiles require literal tabs in recipe lines.
[Makefile]
indent_style = tab
